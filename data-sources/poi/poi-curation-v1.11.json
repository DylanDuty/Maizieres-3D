  "version": "1.11",
  "note": "Curation des lieux identifiables : regroupe sous un même objet les sources officielles (BD TOPO, BAN, OSM) et les extraits de Bibles qui désignent le même lieu, fixe l’ancrage de position et le rang de landmark. Aucune géométrie n’est dessinée ici : un ancrage renvoie toujours à une source (bâtiment du référentiel, adresse BAN, objet BD TOPO, tronçon V1.8, ouvrage V1.9, point de toponymie). Le statut reprend la source la plus récente et la plus prudente ; une information historique n’est jamais rendue actuelle.",
  "anchors": {
   "building": "centre de l’empreinte d’un bâtiment du référentiel V1.6.2",
   "ban": "adresse BAN (numéro et voie identiques) ; bâtiment par le lien BAN PLUS adresse – bâtiment",
   "official": "objet officiel regroupé (BD TOPO, puis OSM)",
   "road": "milieu du plus long tronçon V1.8 portant ce nom (position approximative)",
   "roadId": "milieu d’un tronçon V1.8 donné",
   "routes": "nœud commun à deux routes numérotées V1.8",
   "streets": "nœud commun à deux voies nommées V1.8",
   "toponymie": "point de la couche BD TOPO toponymie",
   "rail": "ouvrage du référentiel ferroviaire V1.9",
   "poi": "même position qu’un autre lieu curé (lieu défini autour d’un repère)",
   "none": "aucune position fiable : nom sans géométrie"
  }
